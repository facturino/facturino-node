{
  "name": "@facturino/node",
  "version": "1.2.0",
  "description": "Official Node.js SDK for the Facturino API — French e-invoicing made simple",
  "license": "MIT",
  "author": "Facturino <dev@facturino.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facturino/facturino-node.git"
  },
  "homepage": "https://facturino.com/docs/api",
  "bugs": {
    "url": "https://github.com/facturino/facturino-node/issues"
  },
  "keywords": [
    "facturino",
    "invoice",
    "e-invoicing",
    "factur-x",
    "french",
    "billing",
    "api",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:cjs:fixup",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cjs:fixup": "node scripts/fixup-cjs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
